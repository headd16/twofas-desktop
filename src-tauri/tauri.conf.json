{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2FAS Desktop",
  "version": "0.1.0",
  "identifier": "io.headcloud.twofas-desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "2FAS Desktop",
        "width": 420,
        "height": 720,
        "minWidth": 360,
        "minHeight": 540,
        "decorations": false,
        "resizable": true,
        "center": true,
        "backgroundColor": "#000000",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/32x32.png", "icons/128x128.png"],
    "shortDescription": "Independent offline Windows authenticator",
    "copyright": "Independent community project. Not affiliated with Two Factor Authentication Service, Inc.",
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "webviewInstallMode": { "type": "downloadBootstrapper" }
    }
  }
}
